# ---------- required ----------
# token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# your Telegram user id (send /id to the bot); comma-separate several admins
ADMIN_IDS=11111111
# channel username or numeric id like -1001234567890
CHANNEL_ID=@your_channel
# on Railway: the mount path of the volume
DATA_DIR=/data

# ---------- optional ----------
# line added under every channel post
SIGNATURE=@your_channel
DEFAULT_DOLLAR_TIME=10:00
DEFAULT_FLIGHTS_TIME=08:00
DEFAULT_SONGS_TIME=21:00
# usd_sell, usd_buy, ...
NAVASAN_ITEM=usd_sell
# official navasan API key (more reliable than reading the page)
NAVASAN_API_KEY=
FLIGHTS_URL=https://www.ikac.ir/en-US/airport.ikac/5257/page/Flights
FLIGHTS_MAX=40
# e.g. http://user:pass@host:port if ikac.ir blocks foreign servers
PROXY_URL=
# set to use OpenAI for images; leave empty for the free Pollinations service
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
